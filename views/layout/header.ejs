<style>
  /* BACKGROUND */
body {
  background: #f7f7f5;
  font-family: 'DM Sans', sans-serif;
  color: #2d2d2d;
}

/* CONTAINER */
.container {
  padding: 40px;
}

/* TITLE */
h1 {
  font-size: 36px;
  font-weight: 500;
  margin-bottom: 10px;
}

p {
  color: #7a7a7a;
}

/* GRID (cards layout) */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 30px;
  margin-top: 30px;
}

/* CARD STYLE (THIS IS YOUR LOST THEME) */
.card {
  background: #ffffff;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-5px);
}

/* SMALL LABEL */
.card small {
  color: #999;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* TITLE INSIDE CARD */
.card h3 {
  margin: 10px 0;
}

/* BUTTON */
.btn {
  display: inline-block;
  margin-top: 10px;
  padding: 8px 16px;
  background: #2d2d2d;
  color: white;
  border-radius: 8px;
  text-decoration: none;
}

  body {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    background: #f7f7f5;
    color: #2d2d2d;
  }

  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 40px;
    background: #ffffff;
    border-bottom: 1px solid #eaeaea;
  }

  .logo {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #2d2d2d;
  }

  .nav-right a {
    text-decoration: none;
    margin-left: 20px;
    color: #555;
    font-weight: 500;
  }

  .logout-btn {
    padding: 6px 14px;
    background: #2d2d2d;
    color: #fff !important;
    border-radius: 6px;
  }

  .container {
    padding: 40px;
  }
</style>

<div class="navbar">
  <div class="logo">NovaCart</div>
<link rel="stylesheet" href="/css/style.css">
  <div class="nav-right">
    <a href="/dashboard">Dashboard</a>
    <a href="/logout" class="logout-btn">Logout</a>
  </div>
</div>

<div class="container">