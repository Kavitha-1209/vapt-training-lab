<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Nova Cart Admin</title>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>
:root {
  --bg: #f9f9f7;
  --card: #ffffff;
  --border: #e5e5e5;
  --gold: #c9a84c;
  --text-primary: #1a1a1a;
  --text-secondary: #6f6f6f;
}

body {
  margin: 0;
  font-family: 'DM Sans', sans-serif;
  background: var(--bg);
  color: var(--text-primary);
}

/* HEADER */
.header {
  padding: 20px 50px;
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px;
  border-bottom: 1px solid var(--border);
  background: white;
}

/* CONTAINER */
.container {
  max-width: 1200px;
  margin: auto;
  padding: 40px 20px;
}

/* TITLE */
.title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 36px;
  font-weight: 400;
  margin-bottom: 30px;
}

/* STATS */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 50px;
}

.card {
  background: var(--card);
  padding: 24px;
  border: 1px solid var(--border);
}

.card-title {
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-secondary);
  margin-bottom: 10px;
}

.card-value {
  font-size: 26px;
  font-weight: 500;
}

/* TABLE SECTION */
.section {
  margin-bottom: 50px;
}

.section-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px;
  margin-bottom: 15px;
}

/* TABLE */
table {
  width: 100%;
  border-collapse: collapse;
  background: var(--card);
  border: 1px solid var(--border);
}

th {
  text-align: left;
  padding: 14px;
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-secondary);
  border-bottom: 1px solid var(--border);
}

td {
  padding: 14px;
  font-size: 14px;
  border-bottom: 1px solid #f0f0f0;
}

tr:hover {
  background: #fafafa;
}

/* BUTTON */
.btn-delete {
  padding: 6px 12px;
  border: 1px solid #e74c3c;
  background: transparent;
  color: #e74c3c;
  cursor: pointer;
  font-size: 12px;
  transition: 0.2s;
}

.btn-delete:hover {
  background: #e74c3c;
  color: white;
}
</style>

</head>
<body>

<div class="header">Nova Cart Admin</div>

<div class="container">

  <div class="title">Control Panel</div>

  <!-- STATS -->
  <div class="stats">
    <div class="card">
      <div class="card-title">Total Users</div>
      <div class="card-value"><%= users.length %></div>
    </div>

    <div class="card">
      <div class="card-title">Products</div>
      <div class="card-value"><%= products.length %></div>
    </div>

    <div class="card">
      <div class="card-title">Status</div>
      <div class="card-value" style="color: var(--gold);">Active</div>
    </div>
  </div>

  <!-- USERS -->
  <div class="section">
    <div class="section-title">Users</div>

    <table>
      <tr>
        <th>ID</th>
        <th>Username</th>
        <th>Email</th>
        <th>Action</th>
      </tr>

      <% users.forEach(user => { %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td>
          <form action="/delete-user/<%= user.id %>" method="POST">
            <button class="btn-delete">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </table>
  </div>

  <!-- PRODUCTS -->
  <div class="section">
    <div class="section-title">Products</div>

    <table>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Price</th>
      </tr>

      <% products.forEach(product => { %>
      <tr>
        <td><%= product.id %></td>
        <td><%= product.name %></td>
        <td>₹<%= product.price.toLocaleString("en-IN") %></td>
      </tr>
      <% }) %>
    </table>
  </div>

</div>

</body>
</html>